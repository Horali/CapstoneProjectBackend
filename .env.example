# Salin berkas milik tim Anda dari koordinator (mis. env/3-A.env) menjadi ".env" di akar repo.
# Berkas ini hanya contoh bentuknya. NILAI PORT DAN NAMA PROYEK DITETAPKAN KOORDINATOR,
# jangan diubah, karena semua tim berbagi satu server dan setiap tim punya angka port sendiri.
# Aturannya (n = nomor tim 1..14):  APP 8100+n | DB 5500+n | DB uji 5600+n | frontend 3100+n

TIM=1-A
COMPOSE_PROJECT_NAME=capstone-m1a

APP_PORT=8101
DB_PORT=5501
TEST_DB_PORT=5601
FE_PORT=3101

# Postgres hanya boleh dijangkau dari server itu sendiri. Dari laptop gunakan terowongan SSH
# (ssh -L 5501:127.0.0.1:5501 ...). Jangan diubah menjadi 0.0.0.0 pada server bersama.
DB_BIND=127.0.0.1

DB_USER=capstone
DB_PASSWORD=ganti-dengan-kata-sandi-acak-hex
DB_NAME=capstone_m1a

# Kunci penandatangan JWT (HS256), minimal 32 karakter acak. Tiap tim punya sendiri.
JWT_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter

# Asal frontend yang diizinkan CORS (frontend tim = localhost:FE_PORT).
CORS_ALLOWED_ORIGINS=http://localhost:3101

# Pengaturan build (ubah hanya bila perlu).
GO_VERSION=1.23
MAIN_PKG=./cmd/server
